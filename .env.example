# Recommended: one OpenRouter key works for every model in DSPyUI's model lists
# (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY="fillthisin"

# Optional: only if you want to call a provider directly instead of through
# OpenRouter. Remove the leading "#" and fill in the key.
# OPENAI_API_KEY="fillthisin"
# ANTHROPIC_API_KEY="fillthisin"
# GEMINI_API_KEY="fillthisin"
# GROQ_API_KEY="fillthisin"
